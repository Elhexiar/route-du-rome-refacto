{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Aliases */
    "paths": {
      "#src/*": ["./src/*"],
      "#Entities/*": ["./src/entities/*"],
      "#IEntities/*": ["./src/interfaces/entities/*"],
      "#Controllers/*": ["./src/controllers/*"],
      "#IControllers/*": ["./src/interfaces/controllers/*"],
      "#Services/*": ["./src/services/*"],
      "#IServices/*": ["./src/interfaces/services/*"],
      "#Repositories/*": ["./src/repositories/*"],
      "#IRepositories/*": ["./src/interfaces/repositories/*"],
      "#UI/*": ["./src/ui/*"],
      "#IUI/*": ["./src/interfaces/ui/*"],
      "#Lib/*": ["./src/lib/*"],
      "#Utils/*": ["./src/utils/*"]
    }
  },
  "include": ["src", "src/entities/.ts"]
}
