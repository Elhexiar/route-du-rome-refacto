@startuml projectOverview

!define THEME_BG #292929
!define THEME_PANEL #333333
!define THEME_ACCENT #d37070
!define THEME_TEXT #F2F2F2

skinparam shadowing false
skinparam backgroundColor THEME_BG
skinparam defaultFontName Arial
skinparam defaultFontColor THEME_TEXT
skinparam rectangleBackgroundColor THEME_PANEL
skinparam rectangleBorderColor THEME_ACCENT
skinparam rectangleFontColor THEME_TEXT
skinparam packageBackgroundColor THEME_PANEL
skinparam packageBorderColor THEME_ACCENT
skinparam packageFontColor THEME_TEXT
skinparam ArrowColor THEME_ACCENT
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 45

left to right direction

title La Route du Rome - Vue système

rectangle "ApplicationContainer\nComposition" as App
rectangle "GameManager\nConsole" as Console
rectangle "Controllers\nHero · Npc · Map\nDialogue · Experience" as Controllers
rectangle "Entities\nHero · Npc · Dialogue\nQuest · Badge" as Entities
rectangle "Services\nQuest · Badge\nNotification · Video" as Services
rectangle "Views\nMap · Dialogue\nSelection · Progression" as Views
rectangle "EventBus\nEvent messages" as EventBus

App --> Controllers : assemble
App --> Services : initialise
App --> Views : construit

Console --> App : inspecte

Controllers --> Entities : manipule
Controllers --> Services : coordonne
Controllers --> Views : pilote

Controllers --> EventBus : publient
Services --> EventBus : publient
EventBus --> Controllers : notifie
EventBus --> Services : notifie

@enduml
