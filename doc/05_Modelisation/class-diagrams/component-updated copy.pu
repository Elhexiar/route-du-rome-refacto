@startuml

left to right direction
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false

package "Route du Rome" {

    package "Application" {
        component "main.ts" as Main
        component GameManager
    }

    package "Controllers" {
        component IHeroController
        component HeroController

        component INpcController
        component NpcController



        component IDialogueController
        component DialogueController

        component IExperienceController
        component ExperienceController

        component IMapController
        component MapController
    }

    package "Services" {
        component QuestService

        component BadgeService

        component "VideoPreloadService" as VideoPreloadService
        component "NativeAudioService" as NativeAudioService

    }



    package "Entities" {
        component Hero
        component Npc
        component Dialogue
        component Quest
        component NPCBadge
    }

}

' Application composition
Main --> GameManager : starts application
GameManager *-- IHeroController : creates
GameManager *-- INpcController : creates
GameManager *-- IDialogueController : creates
GameManager *-- IExperienceController : creates
GameManager *-- IMapController : creates


IExperienceController <-- ExperienceController : implements
IHeroController <-- HeroController : implements
INpcController <-- NpcController : implements
IDialogueController <-- DialogueController : implements
IMapController <-- MapController : implements


HeroController --> Hero : creates from config and manages
NpcController --> Npc : creates from config and manages
DialogueController --> Dialogue : creates from config and manages


ExperienceController --> QuestService : delegates quests
ExperienceController --> BadgeService : delegates badges
DialogueController --> VideoPreloadService : preloads videos
DialogueController --> NativeAudioService : delegates audio

QuestService --> Quest : creates and manages
BadgeService --> NPCBadge : creates quest badges


note top of Services
    Quest and Badge Services have Interfaces but they are circumveted 
    because of rush and time constraints
end note




' ' Controller responsibilities
' HeroController --> Hero : creates and manages
' HeroController --> Dialogue : creates presentation dialogue
' HeroController --> VideoPreloadService : preloads hero videos
' NpcController --> Npc : creates and manages
' NpcController --> Dialogue : creates presentation dialogue
' NpcController --> VideoPreloadService : preloads NPC videos

' MapController *-- LeafletMapView : owns map view
' MapController --> INpcController : receives NPCs
' MapController --> IHeroController : receives selected hero
' LeafletMapView *-- Marker : manages markers
' LeafletMapView --> Leaflet : renders map and tiles

' DialogueController --> IDialogueView : controls dialogue display
' DialogueController --> INpcController : reacts to NPCs
' DialogueController --> IHeroController : reacts to hero changes

' ExperienceController *-- IQuestService : delegates quests
' ExperienceController *-- IBadgeService : delegates badges
' QuestService --> Quest : creates and manages
' QuestService --> NPCBadge : creates quest badges
' QuestService --> QuestCompletedToast : displays completion
' QuestService --> EndToast : displays end state
' BadgeService --> NPCBadge : manages badges
' BadgeService --> NotebookView : displays collected badges

' ' UI interactions
' WelcomeHeroSelectionView --> IHeroController : switches hero
' HeaderHeroSelectionView --> IHeroController : reads selected hero
' DialogueView *-- JobPresentationView : displays presentation
' QuestView --> IQuestService : displays quests
' TutorialView --> GameManager : starts tutorial flow

' ' Runtime resources
' HeroController --> LocalAssets : loads /config.json
' NpcController --> LocalAssets : loads /config.json
' QuestService --> LocalAssets : loads level data
' Main --> ServiceWorker : registers in production
' ServiceWorker --> LocalAssets : caches application shell

@enduml
